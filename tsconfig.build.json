{
    "$schema": "https://json.schemastore.org/tsconfig",
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "rootDir": "./src",
        "outDir": "./dist",
        "noEmit": false,
        "declaration": true,
        "emitDeclarationOnly": true
    },
    "include": [
        "src"
    ],
    "exclude": [
        "src/**/__tests__/**",
        "src/__integration__/**"
    ]
}
