#!/bin/sh
#
# Enforces Conventional Commits: <type>(<optional scope>): <subject>
# Merge and revert commits generated by git are let through.

COMMIT_MSG=$(head -n 1 "$1")
PATTERN='^(feat|fix|docs|style|refactor|perf|test|chore|ci|build|revert)(\([a-z0-9._/-]+\))?!?: .+'

case "$COMMIT_MSG" in
  Merge\ *|Revert\ *|fixup!\ *|squash!\ *) exit 0 ;;
esac

if echo "$COMMIT_MSG" | grep -qE "$PATTERN"; then
  exit 0
fi

printf '\033[31m✖ Commit message does not follow Conventional Commits.\033[0m\n' >&2
printf '\n  Expected: <type>(<scope>): <subject>\n' >&2
printf '  Types:    feat, fix, docs, style, refactor, perf, test, chore, ci, build, revert\n' >&2
printf '  Example:  fix(extension): keep the session on a transient reconnect failure\n\n' >&2
exit 1
