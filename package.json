    "@types/node": "^25.5.2",
    "@typescript-eslint/eslint-plugin": "^5.17.0",
    "@typescript-eslint/parser": "^5.17.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^8.12.0",
    "eslint-config-prettier": "^8.5.0",
    "jsdom": "^25.0.1",
    "prettier": "^2.6.1",
