{
  "name": "@perawallet/connect",
  "version": "1.8.0",
  "description": "JavaScript SDK for integrating Pera Wallet to web applications",
  "license": "ISC",
  "author": "Pera Wallet",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/perawallet/connect.git"
  },
  "bugs": {
    "url": "https://github.com/perawallet/connect/issues"
  },
  "homepage": "https://github.com/perawallet/connect#readme",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "module": "dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": true,
  "scripts": {
    "setup": "git config core.hooksPath .githooks",
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "vite build --watch",
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:types": "oxlint --config .oxlintrc.types.json --type-aware",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt \"**/*.{ts,md,scss}\"",
    "format:check": "oxfmt --check \"**/*.{ts,md,scss}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check:package": "publint --strict && attw --pack --profile esm-only",
    "verify": "pnpm lint && pnpm lint:types && pnpm format:check && pnpm typecheck && pnpm test:coverage && pnpm build && pnpm check:package"
  },
  "dependencies": {
    "@evanhahn/lottie-web-light": "5.13.0",
    "@perawallet/walletconnect": "1.0.3",
    "bowser": "2.14.1",
    "buffer": "^6.0.3",
    "qr-code-styling": "1.9.2",
    "tweetnacl": "^1.0.3"
  },
  "peerDependencies": {
    "algosdk": "^3.5.2"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@types/node": "^24.10.0",
    "@vitest/coverage-v8": "^5.0.3",
    "algosdk": "^3.8.0",
    "jsdom": "^30.0.1",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2003",
    "publint": "^0.3.15",
    "sass": "^1.104.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@10.28.1+sha512.7d7dbbca9e99447b7c3bf7a73286afaaf6be99251eb9498baefa7d406892f67b879adb3a1d7e687fc4ccc1a388c7175fbaae567a26ab44d1067b54fcb0d6a316"
}
